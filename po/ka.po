#: src/rpcc.c:306
msgid ""
"The changes you have made require the Raspberry Pi to be rebooted to take "
"effect.\n"
"\n"
"Would you like to reboot now? "
msgstr ""
"ცვლილებებს, რომლებიც შეიტანეთ, ძალაში შესასვლელად თქვენი Raspberry Pi-ის "
"გადატვირთვა სჭირდება.\n"
"\n"
"გნებავთ ახლავე გადატვირთვა? "

#: src/rpcc.c:309
msgid "_No"
msgstr "_არა"

#: src/rpcc.c:314
msgid "_Yes"
msgstr "_დიახ"

#. show wait message
#: src/rpcc.c:607
msgid "Loading configuration - please wait..."
msgstr "კონფიგურაციის ჩატვირთვა - მოითმინეთ..."

#: data/rpcc.ui:8 data/rpcc.ui:153 data/rpcc.desktop.in:3
msgid "Control Centre"
msgstr "კონტროლის ცენტრი"

#: data/rpcc.ui:25
msgid "_Close"
msgstr "და_ხურვა"

#: data/rpcc.ui:116
msgid "_Cancel"
msgstr "გაუ_ქმება"

#: data/rpcc.ui:130
msgid "_OK"
msgstr "_დიახ"

#: data/rpcc.desktop.in:7
msgid "Configure Raspberry Pi Desktop"
msgstr "Raspberry Pi-ის სამუშაო მაგიდის მორგება"
